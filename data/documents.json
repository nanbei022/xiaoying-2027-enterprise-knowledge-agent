    "doc_id": "D03",
    "title": "正式员工休假申请办法（合成资料）",
    "version_date": "2026-05-01",
    "scope": "正式员工",
    "priority": null,
    "supersedes": [],
    "sections": [
      {
        "section_id": "D03-S1",
        "text": "正式员工申请年假，应至少提前3个工作日提交申请。"
      }
    ]
  },
  {
    "doc_id": "D04",
    "title": "实习生请假办法（合成资料）",
    "version_date": "2026-05-10",
    "scope": "实习生",
    "priority": null,
    "supersedes": [],
    "sections": [
      {
        "section_id": "D04-S1",
        "text": "年假申请办法不适用于实习生。实习生申请事假，应至少提前1个工作日提交申请。"
      }
    ]
  },
  {
    "doc_id": "D05",
    "title": "办公设备故障申报办法（合成资料）",
    "version_date": "2026-04-20",
    "scope": "全体员工",
    "priority": null,
    "supersedes": [],
    "sections": [
      {
        "section_id": "D05-S1",
        "text": "办公设备发生故障时，员工应通过服务台工单系统提交维修申请，并填写设备编号和故障描述。"
      }
    ]
  },
  {
    "doc_id": "D06",
    "title": "正式员工出差申请办法（合成资料）",
    "version_date": "2026-03-01",
    "scope": "正式员工",
    "priority": null,
    "supersedes": [],
    "sections": [
      {
        "section_id": "D06-S1",
        "text": "正式员工提交出差申请，应至少提前2个工作日。"
      },
      {
        "section_id": "D06-S2",
        "text": "正式员工的出差申请应填写目的地和预计费用。"
      }
    ]
  },
  {
    "doc_id": "D07",
    "title": "实习生出差申请办法（合成资料）",
    "version_date": "2026-03-01",
    "scope": "实习生",
    "priority": null,
    "supersedes": [],
    "sections": [
      {
        "section_id": "D07-S1",
        "text": "实习生提交出差申请，应至少提前5个工作日。"
      },
      {
        "section_id": "D07-S2",
        "text": "实习生的出差申请须经带教导师确认。"
      }
    ]
  },
  {

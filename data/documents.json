    "title": "会议室预约办法（合成资料）",
    "version_date": "2026-06-20",
    "scope": "全体员工",
    "priority": null,
    "supersedes": [],
    "sections": [
      {
        "section_id": "D10-S1",
        "text": "员工预约会议室，应至少提前1个工作日提交申请。"
      },
      {
        "section_id": "D10-S2",
        "text": "取消会议室预约，应至少在会议开始前2小时操作。"
      }
